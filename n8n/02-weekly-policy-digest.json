    {
      "parameters": {
        "jsCode": "// Turn the research report into a readable message with sources.\nconst r = $input.first().json;\nconst sources = new Map();\nfor (const claim of r.claims || []) {\n  for (const c of claim.citations || []) {\n    sources.set(c.evidence_id, `${c.evidence_id}: ${c.title} > ${c.section}${c.page ? ', p.' + c.page : ''} (updated ${c.last_modified})`);\n  }\n}\nconst text = [\n  `*Weekly policy digest (AI-generated)* (status: ${r.status})`,\n  '',\n  r.summary,\n  ...(r.notes || []).map(n => `> ${n}`),\n  '',\n  sources.size ? '*Sources*' : '',\n  ...sources.values(),\n].join('\\n');\nreturn [{ json: { text, status: r.status, question: r.question, sources: [...sources.values()] } }];"
      },
      "id": "5219805b-a3d4-5ed4-ac38-b74ba06e4be4",
      "name": "Format digest",
      "type": "n8n-nodes-base.code",
