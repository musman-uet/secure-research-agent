        "httpBearerAuth": {
          "id": "researchAgentToken",
          "name": "Secure Research Agent token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Turn the research report into a readable message with sources.\nconst r = $input.first().json;\nconst sources = new Map();\nfor (const claim of r.claims || []) {\n  for (const c of claim.citations || []) {\n    sources.set(c.evidence_id, `${c.evidence_id}: ${c.title} > ${c.section}${c.page ? ', p.' + c.page : ''} (updated ${c.last_modified})`);\n  }\n}\nconst text = [\n  `*AI-generated research* (status: ${r.status})`,\n  '',\n  r.summary,\n  ...(r.notes || []).map(n => `> ${n}`),\n  '',\n  sources.size ? '*Sources*' : '',\n  ...sources.values(),\n].join('\\n');\nreturn [{ json: { text, status: r.status, question: r.question, sources: [...sources.values()] } }];"
      },
      "id": "6c9c1ffa-896f-53a0-bf57-3ef1760bdafe",
      "name": "Format answer with sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
