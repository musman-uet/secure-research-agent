# Copy to .env and fill in. Never commit .env.

# ---- Retrieval backend: "local" (offline) or "azure" (Azure AI Search) ----
RAG_BACKEND=local

# ---- Research strategy: "off" = deterministic offline agent, "on" = LLM tool-calling agent ----
RESEARCH_LLM=off
RESEARCH_MODEL=gpt-4.1-mini

# OpenAI-compatible API (OpenAI, Groq, a local vLLM/Ollama server)...
OPENAI_API_KEY=
OPENAI_BASE_URL=
# ...or Azure OpenAI (used when AZURE_OPENAI_ENDPOINT is set)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# ---- Azure AI Search (when RAG_BACKEND=azure) ----
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=secure-rag-chunks
AZURE_SEARCH_SEMANTIC=true

# ---- Servers ----
RESEARCH_PUBLIC_URL=http://localhost:8001
RESEARCH_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,host.docker.internal:*

# ---- Tracing: send OpenTelemetry spans to Arize Phoenix, Langfuse, Jaeger... ----
OTEL_EXPORTER_OTLP_ENDPOINT=
RESEARCH_TRACE_CONSOLE=0
